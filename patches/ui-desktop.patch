+    recoveryCode.value = nextCode
+    notice.value = t('desktop.recoveryReady')
+  }
+  catch (err) {
+    error.value = err instanceof Error ? err.message : t('desktop.recoveryUnavailable')
+  }
+  finally {
+    loading.value = false
+  }
+}
+
