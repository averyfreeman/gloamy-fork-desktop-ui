{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gloamy",
  "version": "0.1.1",
  "identifier": "com.gloamy.desktop",
  "build": {
    "beforeDevCommand": {
      "script": "./scripts/prepare-backend-sidecar.sh && ./scripts/prepare-ui.sh dev",
      "cwd": ".."
    },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": {
      "script": "./scripts/prepare-backend-sidecar.sh && ./scripts/prepare-ui.sh build",
      "cwd": ".."
    },
    "frontendDist": "../.desktop-build/ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Gloamy",
        "url": "index.html#/configuration",
        "width": 1200,
        "height": 850,
        "minWidth": 900,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://localhost:* http://127.0.0.1:* http://[::1]:*; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/gloamy": "gloamy"
    }
  }
}
